* {
    margin: 0px;
    padding: 0px;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: white;
    color: black;
}

header {
    padding: 30px;
    background-color: aqua;
    display: flex;
    text-align: center;
    align-items: center;
    justify-content: space-between;
    gap: 15px;

}

nav {
    ul {

        list-style: none;
        display: inline;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 20px;

        a {
            color: black;
            text-decoration: none;
        }
    }
}

#hero {
    text-align: center;
    padding: 30px 0px;
    flex-direction: column;

    button {
        border-radius: 5px;
        padding: 10px;

    }

    button:hover {
        background-color: aqua;
        transform: translateY(-8px) scale(1.15);
        transition: transform 0.3s ease;
    }

    h1 {
        align-items: center;
        font-size: 50px;
        font-style: italic;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    p {
        align-items: center;
        font-size: 20px;
        margin: 20px;
    }

}

.course-card {
    padding: 50px;
    border-radius: 15px;
    border: 10px;
    border-color: aliceblue;
    box-shadow: 10px 20px 50px rgba(5, 5, 5, 0.5);
    margin: 40px 400px;
    min-height: 220px;
    align-self: stretch;

}

#courses h2 {
    padding-left: 100px;
}

#stats {
    display: flex;
    margin: 50px 400px;
    justify-content: space-between;

    .stat {
        align-items: center;
        border: 10px;
        border-radius: 20px;
        border-color: white;
        box-shadow: 0px 0px 50px rgba(5, 5, 5, 0.5);
        justify-content: space-between;
        padding: 30px 40px;

    }

    .stat:hover {
        background-color: aqua;
    }

    .stat h3 {
        margin-bottom: 10px;
        text-align: center;
    }
}

.course-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
}