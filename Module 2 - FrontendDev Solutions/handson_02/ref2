* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}


body {
    font-family: Arial, sans-serif;
    background-color: #f5f5f5;
    color: #333;
}

header {
    background-color: aqua;
    padding: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 15px;
    font-style: italic;
}



header h1 {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-style: italic;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}


nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 15px;
}

nav ul li {
    list-style: none;
}

nav ul li a {
    text-decoration: none;
    color: black;
    font-weight: bold;
}

nav ul li a:hover {
    color: white;
}

#hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 40vh;
    text-align: center;
    padding: 40px 20px;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    font-style: italic;
}

#hero h1 {
    margin-bottom: 20px;
}

#hero p {
    font-size: 20px;
    margin-bottom: 20px;
}

#hero button {
    padding: 12px 25px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    transition: 0.3s ease;
}

#hero button:hover {
    background-color: aqua;
    transform: translateY(-5px);
}


#stats {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 20px;
}

.stat {
    background-color: white;
    border: 1px solid #ddd;
    border-radius: 15px;
    padding: 25px;
    text-align: center;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
    transition: 0.3s;
}

.stat:hover {
    background-color: aqua;
}

.stat h3 {
    margin-bottom: 10px;
}

#courses {
    padding: 40px 20px;
}

#courses h2 {
    text-align: center;
    margin-bottom: 30px;
}


.course-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
}


.course-card {
    background-color: white;
    padding: 25px;
    border: 1px solid #ddd;
    border-radius: 15px;
    min-height: 220px;
    align-self: stretch;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.2);
    transition: 0.3s;
}

.course-card:hover {
    transform: translateY(-5px);
}

.course-card h3 {
    margin-bottom: 15px;
}

.course-card p {
    margin-bottom: 15px;
}

.course-card span {
    font-weight: bold;
    color: blue;
}

footer {
    background-color: aqua;
    text-align: center;
    padding: 20px;
    margin-top: 40px;
}

@media (min-width: 768px) {

    header {
        flex-direction: row;
        justify-content: space-between;
    }

    nav ul {
        flex-direction: row;
    }

    #stats {
        flex-direction: row;
        justify-content: space-between;
    }

    .stat {
        flex: 1;
    }

    .course-grid {
        grid-template-columns: repeat(2, 1fr);
    }

}

@media (min-width: 1024px) {

    .course-grid {
        grid-template-columns: repeat(3, 1fr);
    }

    #hero {
        padding: 80px 20px;
    }

}